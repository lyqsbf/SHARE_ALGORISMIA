#include <iostream>
#include <vector>
using namespace std;

using VI = vector<long long>;
using VVI = vector<VI>;
VI V;
int m, n;
VVI memo;


long long f(int pos, int i){
	if (i == n) {
		++memo[pos][n];
		//if (memo[pos] == 1) cout << pos - m/2 << ' ' << memo[pos] << endl;
		//cout << pos - m/2 << endl;
		//cout << memo[pos] << endl;
		return memo[pos][n];
	}
	
	if (memo[pos][i] != 0) {
		//memo[pos][n + 1] += memo[pos][i];
		return memo[pos][i];
	}
	
	long long result = 0;
	if (pos - V[i] >= 0) result = 1 + f(pos - V[i], i + 1);
	if (pos + V[i] < m) result = 1 + f(pos + V[i], i + 1);
	memo[pos][i] = result;
	return result;
}


int main(){
	cin >> m >> n;
	V = VI(n);
	memo = VVI(m, VI(n + 1, 0));
	for (int i = 0; i < n; ++i){
		int k;
		cin >> k;
		V[i] = k;
	}
	if (n != 0) f(m/2, 0);
	else cout << 0 << ' ' << 1 << endl;
	for (int i = 0; i < m; ++i) {
		if (memo[i][n] != 0) cout << i - m/2 << ' ' << memo[i][n] << endl;
	}
	//for (int i = 0; i < m + 1; ++i) cout << memo[i] << ' ';
}
