#include <iostream> 
#include <vector> 
using namespace std; 

/* l'ordre dels caps ja ve determinat (el primer sempre tindra A, el segon
 * B, etc). La resta consisteix en fer dues permutacions de 1,..,n dins un 
 * vector de mida 2n on parells son el cos i senars cames
 */
 
using VE = vector <int>;
using VB = vector <bool>;  

int n; 
VE v;
VB cossos, cames; 

void print () {
	bool coma = false;
	for (int i = 0; i < 2*n; i += 2) {
		if (coma) cout << '-'; 
		coma = true; 
		char cap = 'A' + i/2; 
		char cama = 'a' + v[i+1] - 1;
		cout << cap << v[i] - 1 << cama; 
	}
	cout << endl;
}

void f (int m) {
	if (m == 2*n) return print(); 
	for (int i = 0; i < n; ++i) {
		if (not cames[i] and m%2 == 1) {
			cames[i] = true; 
			v[m] = i + 1; 
			f(m + 1); 
			cames[i] = false; 
		}
		if (not cossos[i] and m%2 == 0) {
			cossos[i] = true; 
			v[m] = i + 1; 
			f(m + 1); 
			cossos[i] = false;
		}
	}
}

int main () {
	int i = 0;
	while (cin >> n and n != 0) {
		v = VE(2*n); 
		cossos = VB(n, false); 
		cames = VB(n, false);
		++i;
		cout << "Case " << i << endl;
		f(0);
	}
}
